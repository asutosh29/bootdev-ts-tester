#!/bin/sh

# Git provides push details via standard input in the format:
# <local ref> <local sha1> <remote ref> <remote sha1>
while read -r local_ref local_sha remote_ref remote_sha; do
  
  # Check if the push is targeting a standard branch
  case "$remote_ref" in
    refs/heads/*)
      
      # Extract just the branch name
      remote_branch="${remote_ref#refs/heads/}"
      
      # Check if the branch is main or master
      case "$remote_branch" in
        main|master)
          echo ""
          echo "🚫 ERROR: Direct pushes to the '$remote_branch' branch are forbidden."
          echo "Please push to a feature branch and create a Pull Request."
          echo "Push attempted: $local_ref -> $remote_ref"
          echo ""
          exit 1
          ;;
      esac
      ;;
  esac
done

exit 0